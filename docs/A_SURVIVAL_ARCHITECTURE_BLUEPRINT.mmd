  classDef data fill:#3a2520,stroke:#ffc857,color:#fff6dc;
  class APP,VP,PWA,ID,GATE,INPUT shell;
  class MAN,RES,CACHE,TEX,ATLAS,MODEL,ANIM,FX,MAPPAK pack;
  class SESSION,WORLD,GEN,CHUNK,VISIBLE,RENDER,VISUAL,PLAYER,COMBAT,ITEM,MAPSTATE,FEEDBACK runtime;
  class DB,QUEUE,TRANSPORT,LAN data;
